OPENAI_API_KEY=your_api_key
OPENAI_MODEL=gpt-6-luna
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_write_capable_token
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PREFIX=rag:rate-limit
OPENAI_MAX_COMPLETION_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=0
REDIS_TIMEOUT_SECONDS=10
TOP_K=5
EMBED_MODEL=all-MiniLM-L6-v2

# Aggregate operations only: no questions, answers or visitor identifiers retained.
OPS_ENABLED=0
OPS_READ_TOKEN=
OPS_PREFIX=docwise:operations:v1
# Optional explicit pricing. Leave blank until verified for the deployed model.
OPS_PROMPT_USD_PER_MILLION=
OPS_OUTPUT_USD_PER_MILLION=
